{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacepact",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "vars": {
    "APP_URL": "https://pacepact.maximilianauer.at",
    // iCloud link of the shared "Pacepact run" shortcut (https://www.icloud.com/shortcuts/…); empty = not offered yet.
    "APPLE_SHORTCUT_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pacepact",
      // Created with `npx wrangler d1 create pacepact --jurisdiction eu`.
      "database_id": "66147933-9beb-453d-ade3-6b8ea72f1ec9",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "pacepact.maximilianauer.at", "custom_domain": true }]
}
