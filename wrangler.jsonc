{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacepact",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "vars": { "APP_URL": "https://pacepact.maximilianauer.at" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pacepact",
      // Replace with the id printed by `npx wrangler d1 create pacepact --jurisdiction eu`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "pacepact.maximilianauer.at", "custom_domain": true }]
}
