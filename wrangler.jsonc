{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pacepact",
  "main": ".open-next/worker.js",
  // Builds the Worker with OpenNext before every `wrangler deploy`, so deploys work with
  // Cloudflare's default build settings (`npx wrangler deploy`) as well as the OpenNext commands.
  "build": { "command": "npx opennextjs-cloudflare build" },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "vars": { "APP_URL": "https://pacepact.maximilianauer.at" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pacepact",
      // Created with `npx wrangler d1 create pacepact --jurisdiction eu`.
      "database_id": "66147933-9beb-453d-ade3-6b8ea72f1ec9",
      "migrations_dir": "drizzle"
    }
  ],
  "routes": [{ "pattern": "pacepact.maximilianauer.at", "custom_domain": true }]
}
