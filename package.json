{
  "name": "pacepact",
  "version": "0.1.0",
  "private": true,
  "description": "Pacepact \u2013 a running tracker for goals, groups and race preparation.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@opennextjs/cloudflare": "1.20.16",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.0",
    "fit-file-parser": "1.21.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  }
}
