# Public base URL of the app (used for OAuth redirect URLs).
APP_URL=http://localhost:3000

# Postgres connection string for production. Leave empty to use the
# embedded PGlite database in ./.data (great for local development).
DATABASE_URL=

# 32+ random bytes, base64. Encrypts provider tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Integrations (each is optional; only configured ones are offered) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=

# Garmin and COROS require partner approval before credentials are issued.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
