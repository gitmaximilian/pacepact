# Local development: copy to .dev.vars (read by `next dev` and `wrangler dev`).
# Production: set each secret with `npx wrangler secret put NAME`.
# APP_URL is set in wrangler.jsonc ("vars").

# Public base URL of the app (used for OAuth redirect URLs).
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Encrypts provider tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Integrations (each is optional; only configured ones are offered) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=

WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=

SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=

# Required for the Strava webhook: events from other subscriptions (or without this set) are ignored.
STRAVA_SUBSCRIPTION_ID=

# Garmin Connect and COROS require partner approval and are not wired up yet.
# Until then, users can sync those watches to Strava or upload FIT files.
